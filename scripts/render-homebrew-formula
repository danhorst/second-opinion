#!/usr/bin/env python3
"""Render the canonical formula; no network access or secret handling."""
import pathlib
import re
import sys

if len(sys.argv) != 3 or not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+", sys.argv[1]) or not re.fullmatch(r"[0-9a-f]{64}", sys.argv[2]):
    sys.exit("usage: render-homebrew-formula vX.Y.Z SHA256")
source = pathlib.Path(__file__).resolve().parent.parent / "packaging/homebrew/second-opinion.rb.in"
sys.stdout.write(source.read_text().replace("@TAG@", sys.argv[1]).replace("@SHA256@", sys.argv[2]))
